<Window x:Class="OneSync.Widget.SyncStatusWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="340"
        SizeToContent="Height"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" ResizeBorderThickness="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dark palette. WidgetTheme swaps these for the light one when Windows is in light mode -->
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#C5FFFFFF"/>
        <SolidColorBrush x:Key="TertiaryText" Color="#8BFFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="Divider" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="SubtleFill" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="SubtleFillPressed" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="ProgressBrush" Color="#FFC83D"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="#FF99A4"/>
        <SolidColorBrush x:Key="CriticalFill" Color="#1FFF99A4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
        <SolidColorBrush x:Key="ScrollThumb" Color="#5CFFFFFF"/>

        <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Quiet text button, like the ones in Windows' own flyouts -->
        <Style x:Key="SubtleBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillPressed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource SubtleBtn}">
            <Setter Property="Background" Value="{DynamicResource SubtleFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource SubtleBtn}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- Thin scrollbar: a 2px line that widens when you reach for it -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="{DynamicResource ScrollThumb}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TertiaryText}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SecondaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Margin" Value="2,2,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource ThumbStyle}"
                                       Width="2" HorizontalAlignment="Right"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter CanContentScroll="False"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HideWhenEmpty" TargetType="ItemsControl">
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ScrollingItems" TargetType="ItemsControl">
            <ScrollViewer Style="{StaticResource ListScroller}">
                <ItemsPresenter/>
            </ScrollViewer>
        </ControlTemplate>
    </Window.Resources>

    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Stroke}">
        <Border.Background>
            <SolidColorBrush x:Name="WindowBg" Color="#B3202020"/>
        </Border.Background>

        <StackPanel Margin="16,14,16,14">

            <!-- Toasts -->
            <ItemsControl ItemsSource="{Binding Toasts}" Style="{StaticResource HideWhenEmpty}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SubtleFill}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8,4,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Body}"
                                           FontSize="12" TextWrapping="Wrap" TextTrimming="None"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconBtn}"
                                        Command="{Binding DismissCommand}" Margin="6,-2,0,-2"
                                        VerticalAlignment="Top" ToolTip="Dismiss"
                                        Visibility="{Binding IsPersistent, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderIconText" Text="{Binding HeaderIcon}" Style="{StaticResource Icon}"
                           FontSize="16" Height="16" Width="16" LineHeight="16"
                           LineStackingStrategy="BlockLineHeight" Margin="0,0,10,0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="HeaderSpin"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding HeaderText}" Style="{StaticResource Body}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconBtn}"
                        Command="{Binding HideCommand}" ToolTip="Hide until something changes"
                        Margin="8,-4,-6,-4" VerticalAlignment="Center"/>
            </Grid>

            <!-- Drive statuses (starting state) -->
            <ItemsControl ItemsSource="{Binding DriveStatuses}" Style="{StaticResource HideWhenEmpty}"
                          Margin="26,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Syncing files -->
            <ItemsControl ItemsSource="{Binding SyncingFiles}" Style="{StaticResource HideWhenEmpty}"
                          Template="{StaticResource ScrollingItems}" Margin="-8,10,-8,0" MaxHeight="252">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="FileRow" CornerRadius="4" Padding="8,6" Background="Transparent"
                                Loaded="FileRow_Loaded"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RowIcon" Text="{Binding Glyph}" Style="{StaticResource Icon}"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid HorizontalAlignment="Left" ToolTip="{Binding FullPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NameStem}" Style="{StaticResource Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NameExtension}" Style="{StaticResource Body}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                               Margin="0,1,0,0"/>
                                    <Grid Height="2" Margin="0,6,0,1"
                                          Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{DynamicResource TrackBrush}" CornerRadius="1"/>
                                        <Border Background="{DynamicResource ProgressBrush}" CornerRadius="1"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding ProgressFraction}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                <Setter TargetName="RowIcon" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="FileRow"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            From="#1F6CCB5F" To="#006CCB5F" Duration="0:0:0.6">
                                                <ColorAnimation.EasingFunction>
                                                    <ExponentialEase EasingMode="EaseOut"/>
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <Trigger SourceName="FileRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="FileRow" Property="Background" Value="{DynamicResource SubtleFill}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Error files -->
            <ItemsControl ItemsSource="{Binding ErrorFiles}" Style="{StaticResource HideWhenEmpty}"
                          Template="{StaticResource ScrollingItems}" Margin="-8,10,-8,0" MaxHeight="204">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ErrRow" CornerRadius="4" Padding="8,6" Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}"
                                           Foreground="{DynamicResource CriticalBrush}" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid HorizontalAlignment="Left" ToolTip="{Binding FullPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NameStem}" Style="{StaticResource Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NameExtension}" Style="{StaticResource Body}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" TextTrimming="None"
                                               ToolTip="{Binding ErrorDetail}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Retry" Style="{StaticResource SubtleBtn}"
                                        Command="{Binding RetryCommand}" VerticalAlignment="Center"
                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="ErrRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ErrRow" Property="Background" Value="{DynamicResource SubtleFill}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Retry all -->
            <Button Content="Retry all" Style="{StaticResource OutlineBtn}"
                    Command="{Binding RetryAllCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"/>

        </StackPanel>
    </Border>
</Window>
